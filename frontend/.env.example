VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# 게임 백엔드 연결 시:
#   VITE_API_MODE=http
#   VITE_API_BASE_URL=/api
#   VITE_API_PROXY_TARGET=http://127.0.0.1:8080
#
# VITE_API_PROXY_TARGET은 vite 개발 서버의 프록시 대상이다. 백엔드에 CORS 설정이 없어
# 브라우저가 8080을 직접 호출하면 차단되므로 개발에서는 프록시를 거쳐야 한다.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
