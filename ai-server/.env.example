# Reference only: Spring Boot does not automatically load this file.
# Set these values as process environment variables or deployment secrets.

# AI server
PORT=8081
AI_INTERNAL_API_KEY=arcadia-local-shared-key-change-me

# Safe local integration mode: no external AI API is called.
AI_ENABLED=true
AI_OFFLINE_MODE=true

# Online provider selection
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI alternative
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Generation and quota behavior
AI_CASE_GENERATION_TIMEOUT=60s
AI_CASE_GENERATION_MAX_RETRIES=2
AI_QUOTA_COOLDOWN=10m
